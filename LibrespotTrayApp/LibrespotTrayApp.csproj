<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- Lets the project build on Linux/macOS too (CI checks, tooling). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <AssemblyName>LibrespotTrayApp</AssemblyName>
    <RootNamespace>LibrespotTrayApp</RootNamespace>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationDefaultFont>Segoe UI, 9pt</ApplicationDefaultFont>

    <Version>2.0.0</Version>
    <Product>Librespot Tray App</Product>
    <Company>Mathr81</Company>
    <Copyright>Mathr81</Copyright>
    <NeutralLanguage>fr</NeutralLanguage>
    <!-- Globalization is invariant: framework translations would never be used. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!--
    Runtime settings chosen for a tray app that must stay as light as possible while sitting idle
    (e.g. during a game): no background GC thread, no ICU, no tiered PGO instrumentation, and the
    Windows thread pool instead of the managed one (fewer dedicated threads).
  -->
  <PropertyGroup>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <UseWindowsThreadPool>true</UseWindowsThreadPool>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EventSourceSupport>false</EventSourceSupport>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\app.ico" LogicalName="app.ico" />
    <EmbeddedResource Include="Resources\app-inactive.ico" LogicalName="app-inactive.ico" />
  </ItemGroup>

  <!-- librespot.exe is built from source by librespot\build.ps1 (see README). -->
  <PropertyGroup>
    <LibrespotExePath>$(MSBuildThisFileDirectory)..\librespot\bin\librespot.exe</LibrespotExePath>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(LibrespotExePath)')">
    <None Include="$(LibrespotExePath)" Link="librespot.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireLibrespotForPublish" BeforeTargets="PrepareForPublish" Condition="!Exists('$(LibrespotExePath)')">
    <Error Text="librespot.exe introuvable ($(LibrespotExePath)) : lancez librespot\build.ps1 avant de publier." />
  </Target>
  <Target Name="WarnMissingLibrespot" BeforeTargets="Build" Condition="!Exists('$(LibrespotExePath)')">
    <Warning Text="librespot.exe introuvable ($(LibrespotExePath)). Lancez librespot\build.ps1 pour le compiler." Code="LTA001" />
  </Target>

</Project>
